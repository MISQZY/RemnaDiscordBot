# --- Discord ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# OAuth2 → Client Secret in the Developer Portal; the API needs it for Discord login
DISCORD_CLIENT_SECRET=
# Guild for instant command registration during development (empty = global)
DISCORD_DEV_GUILD_ID=

# Sync slash commands with Discord on bot startup (only differences are changed)
AUTO_DEPLOY_COMMANDS=true

# --- Sharding ---
# auto — as recommended by Discord
TOTAL_SHARDS=auto
SHARDS_PER_CLUSTER=4

# --- Storage ---
POSTGRES_USER=bot
POSTGRES_PASSWORD=bot
POSTGRES_DB=bot
DATABASE_URL=postgresql://bot:bot@localhost:5432/bot
REDIS_URL=redis://localhost:6379

# --- API ---
API_HOST=127.0.0.1
API_PORT=3000
# Public API URL; add <API_PUBLIC_URL>/v1/auth/callback to OAuth2 → Redirects
API_PUBLIC_URL=http://localhost:3000
# Web platform URL (CORS and post-login redirect); empty — login lands on the API Swagger UI
WEB_ORIGIN=
# Cookie signing and token encryption, at least 32 characters: openssl rand -base64 32
SESSION_SECRET=

# --- Notifications ---
# Twitch app (dev.twitch.tv/console) for stream notifications; empty — Twitch is unavailable
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Worker ---
WORKER_POLL_MS=2000
WORKER_HEALTH_PORT=3002

# --- Misc ---
LOG_LEVEL=info
DEFAULT_LOCALE=ru
BOT_HEALTH_PORT=3001
