# --- Discord ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# OAuth2 → Client Secret в Developer Portal; нужен API для входа через Discord
DISCORD_CLIENT_SECRET=
# Гильдия для быстрой регистрации команд при разработке (пусто = глобально)
DISCORD_DEV_GUILD_ID=

# --- Шардинг ---
# auto — по рекомендации Discord
TOTAL_SHARDS=auto
SHARDS_PER_CLUSTER=4

# --- Хранилища ---
POSTGRES_USER=bot
POSTGRES_PASSWORD=bot
POSTGRES_DB=bot
DATABASE_URL=postgresql://bot:bot@localhost:5432/bot
REDIS_URL=redis://localhost:6379

# --- API ---
API_HOST=127.0.0.1
API_PORT=3000
# Публичный адрес API; добавьте <API_PUBLIC_URL>/v1/auth/callback в OAuth2 → Redirects
API_PUBLIC_URL=http://localhost:3000
# Адрес веб-платформы (CORS и редирект после входа); пусто — после входа откроется Swagger UI API
WEB_ORIGIN=
# Подпись cookie и шифрование токенов, не короче 32 символов: openssl rand -base64 32
SESSION_SECRET=

# --- Оповещения ---
# Приложение Twitch (dev.twitch.tv/console) для оповещений о стримах; пусто — Twitch недоступен
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Воркер ---
WORKER_POLL_MS=2000
WORKER_HEALTH_PORT=3002

# --- Прочее ---
LOG_LEVEL=info
DEFAULT_LOCALE=ru
BOT_HEALTH_PORT=3001
