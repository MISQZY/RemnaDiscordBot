# --- Image (the tag the main server deployed: IMAGE_TAG in its .env) ---
IMAGE_REPO=ghcr.io/<owner>/<repo>
IMAGE_TAG=latest

# --- Discord ---
DISCORD_TOKEN=

# --- Sharding: the same TOTAL_SHARDS, SHARDS_PER_CLUSTER and SHARD_HOSTS as on every server ---
TOTAL_SHARDS=8
SHARDS_PER_CLUSTER=4
SHARD_HOSTS=2
# This server, from 1 (0 is the main server, which also syncs slash commands)
SHARD_HOST_INDEX=1

# --- Storage on the main server, at its STORAGE_BIND address (a private network such as WireGuard) ---
# connection_limit keeps each cluster's pool small: every server's clusters share Postgres's max_connections
DATABASE_URL=postgresql://bot:<POSTGRES_PASSWORD>@10.77.0.1:5432/bot?connection_limit=5
# REDIS_PASSWORD of the main server; hex (openssl rand -hex 32) needs no URL encoding
REDIS_URL=redis://:<REDIS_PASSWORD>@10.77.0.1:6379

# --- Modules: as in the main server's .env (the rest of it, e.g. TWITCH_*, may be copied as is) ---
DEFAULT_LOCALE=ru
RANK_CARD_URL=
RANK_CARD_SECRET=
# Lavalink of the main server, published at STORAGE_BIND; empty — music is off on this server's guilds
LAVALINK_NODES=lavalink://<LAVALINK_PASSWORD>@10.77.0.1:2333

# --- Misc ---
LOG_LEVEL=info
# Memory cap of the bot container
BOT_MEMORY=1g
