generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Discord-сервер и его общие настройки.
model Guild {
  id          String    @id
  locale      String    @default("ru")
  timezone    String    @default("Europe/Moscow")
  /// ID ролей модераторов (JSON-массив: схема переносима на SQLite для тестов).
  modRoleIds  Json      @default("[]")
  premiumTier Int       @default(0)
  joinedAt    DateTime  @default(now())
  /// Бот удалён с сервера; данные чистятся позже задачей обслуживания.
  leftAt      DateTime?

  modules GuildModuleConfig[]
}

/// Конфиг модуля для гильдии. `config` валидируется zod-схемой модуля.
model GuildModuleConfig {
  guildId   String
  moduleId  String
  enabled   Boolean  @default(false)
  config    Json
  version   Int
  updatedAt DateTime @updatedAt
  updatedBy String?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, moduleId])
}

/// Пользователь веб-платформы (Discord user).
model DashboardUser {
  id         String   @id
  username   String
  avatar     String?
  locale     String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
}

/// История изменений настроек через API.
model DashboardAuditLog {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  moduleId  String?
  action    String
  diff      Json?
  createdAt DateTime @default(now())

  @@index([guildId, createdAt])
}

/// Отложенные действия (снятие бана, задержанная выдача роли…). Воркер забирает их атомарно.
model ScheduledAction {
  id          String    @id @default(cuid())
  /// Необязательный ключ: повторное планирование с тем же ключом заменяет задачу, по нему же отмена.
  key         String?   @unique
  guildId     String
  /// `<moduleId>:<job>`
  type        String
  payload     Json
  runAt       DateTime
  doneAt      DateTime?
  /// Задача взята воркером до этого момента; после — может быть взята снова.
  lockedUntil DateTime?
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())

  @@index([runAt, doneAt])
  @@index([guildId])
}

/// Панель самостоятельного выбора ролей: сообщение с кнопками или выпадающим списком (модуль autoroles).
model RolePanel {
  id        String   @id @default(cuid())
  guildId   String
  channelId String
  /// Сообщение в Discord; `null` — панель ещё не опубликована.
  messageId String?
  /// `buttons` | `select`
  kind      String
  /// `toggle` | `add` | `remove` | `unique`
  mode      String
  maxRoles  Int?
  /// MessageTemplate — текст над кнопками.
  message   Json
  /// [{ roleId, label, emoji?, style?, description? }]
  items     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId])
}

/// Роли участника на момент выхода — для восстановления при возвращении (модуль autoroles).
model MemberRoleBackup {
  guildId String
  userId  String
  /// JSON-массив ID ролей.
  roleIds Json
  savedAt DateTime @updatedAt

  @@id([guildId, userId])
}
