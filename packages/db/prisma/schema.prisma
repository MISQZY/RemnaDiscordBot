generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Discord-сервер и его общие настройки.
model Guild {
  id          String    @id
  locale      String    @default("ru")
  timezone    String    @default("Europe/Moscow")
  /// ID ролей модераторов (JSON-массив: схема переносима на SQLite для тестов).
  modRoleIds  Json      @default("[]")
  premiumTier Int       @default(0)
  joinedAt    DateTime  @default(now())
  /// Бот удалён с сервера; данные чистятся позже задачей обслуживания.
  leftAt      DateTime?

  modules GuildModuleConfig[]
}

/// Конфиг модуля для гильдии. `config` валидируется zod-схемой модуля.
model GuildModuleConfig {
  guildId   String
  moduleId  String
  enabled   Boolean  @default(false)
  config    Json
  version   Int
  updatedAt DateTime @updatedAt
  updatedBy String?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, moduleId])
}

/// Пользователь веб-платформы (Discord user).
model DashboardUser {
  id         String   @id
  username   String
  avatar     String?
  locale     String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
}

/// История изменений настроек через API.
model DashboardAuditLog {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  moduleId  String?
  action    String
  diff      Json?
  createdAt DateTime @default(now())

  @@index([guildId, createdAt])
}

/// Отложенные действия (снятие бана, задержанная выдача роли…). Воркер забирает их атомарно.
model ScheduledAction {
  id          String    @id @default(cuid())
  /// Необязательный ключ: повторное планирование с тем же ключом заменяет задачу, по нему же отмена.
  key         String?   @unique
  guildId     String
  /// `<moduleId>:<job>`
  type        String
  payload     Json
  runAt       DateTime
  doneAt      DateTime?
  /// Задача взята воркером до этого момента; после — может быть взята снова.
  lockedUntil DateTime?
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())

  @@index([runAt, doneAt])
  @@index([guildId])
}

/// Панель самостоятельного выбора ролей: сообщение с кнопками или выпадающим списком (модуль autoroles).
model RolePanel {
  id        String   @id @default(cuid())
  guildId   String
  channelId String
  /// Сообщение в Discord; `null` — панель ещё не опубликована.
  messageId String?
  /// `buttons` | `select`
  kind      String
  /// `toggle` | `add` | `remove` | `unique`
  mode      String
  maxRoles  Int?
  /// MessageTemplate — текст над кнопками.
  message   Json
  /// [{ roleId, label, emoji?, style?, description? }]
  items     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId])
}

/// Роли участника на момент выхода — для восстановления при возвращении (модуль autoroles).
model MemberRoleBackup {
  guildId String
  userId  String
  /// JSON-массив ID ролей.
  roleIds Json
  savedAt DateTime @updatedAt

  @@id([guildId, userId])
}

/// Кейс модерации: бан, кик, мут, предупреждение… Номер последовательный в пределах гильдии.
model ModCase {
  id           String    @id @default(cuid())
  guildId      String
  number       Int
  /// `ban` | `unban` | `kick` | `mute` | `unmute` | `warn`
  type         String
  targetId     String
  moderatorId  String
  reason       String?
  durationSec  Int?
  /// Окончание временного наказания или срок действия предупреждения.
  expiresAt    DateTime?
  /// Снято досрочно (разбан, снятие мута, снятие предупреждения).
  revokedAt    DateTime?
  revokedBy    String?
  revokeReason String?
  createdAt    DateTime  @default(now())

  @@unique([guildId, number])
  @@index([guildId, targetId, type])
}

/// Последний номер кейса в гильдии — атомарный инкремент через upsert.
model ModCaseCounter {
  guildId String @id
  last    Int
}

/// Опыт участника (модуль leveling). Имя и аватар — для лидерборда без запросов к Discord.
model MemberLevel {
  guildId   String
  userId    String
  xp        Int      @default(0)
  level     Int      @default(0)
  messages  Int      @default(0)
  username  String?
  avatar    String?
  updatedAt DateTime @updatedAt

  @@id([guildId, userId])
  @@index([guildId, xp])
}

/// Пользовательская команда гильдии: slash-команда или автоответ на сообщение (модуль custom-commands).
model CustomCommand {
  id                String   @id @default(cuid())
  guildId           String
  /// Имя slash-команды или название триггера; уникально в гильдии.
  name              String
  /// `slash` | `trigger`
  kind              String
  description       String?
  /// Для триггера: `exact` | `startsWith` | `contains` | `regex`
  matchMode         String?
  pattern           String?
  /// MessageTemplate ответа.
  response          Json
  ephemeral         Boolean  @default(false)
  /// { addRoleIds, removeRoleIds, deleteTrigger }
  actions           Json
  allowedChannelIds Json
  allowedRoleIds    Json
  cooldownSec       Int      @default(0)
  enabled           Boolean  @default(true)
  /// ID guild-команды в Discord (для slash).
  discordCommandId  String?
  uses              Int      @default(0)
  createdBy         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([guildId, name])
}

/// Внешний источник оповещений (канал YouTube, стример Twitch) — один на всю платформу.
model NotificationSource {
  id            String    @id @default(cuid())
  /// `youtube` | `twitch`
  provider      String
  /// ID канала YouTube или пользователя Twitch.
  externalId    String
  name          String
  /// Последнее объявленное видео или стрим — чтобы не повторяться.
  lastItemId    String?
  lastCheckedAt DateTime?
  createdAt     DateTime  @default(now())

  subscriptions NotificationSubscription[]

  @@unique([provider, externalId])
}

/// Подписка гильдии на источник: куда и каким сообщением объявлять (модуль notifications).
model NotificationSubscription {
  id            String   @id @default(cuid())
  guildId       String
  sourceId      String
  channelId     String
  mentionRoleId String?
  /// MessageTemplate анонса.
  message       Json
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())

  source NotificationSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([guildId, sourceId])
  @@index([sourceId])
}
