{
  "name": "discord-bot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test test:integration",
    "deploy-commands": "pnpm --filter @bot/bot deploy-commands",
    "db:generate": "pnpm --filter @bot/db db:generate",
    "db:migrate": "pnpm --filter @bot/db db:migrate",
    "db:deploy": "pnpm --filter @bot/db db:deploy",
    "db:studio": "pnpm --filter @bot/db db:studio",
    "test:integration": "turbo run test:integration",
    "dev:local": "tsx --conditions=development scripts/dev-local.mjs"
  },
  "devDependencies": {
    "@bot/db": "workspace:*",
    "@bot/testing": "workspace:*",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
