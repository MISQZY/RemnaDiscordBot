# --- Discord ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# OAuth2 → Client Secret in the Developer Portal; the API needs it for Discord login
DISCORD_CLIENT_SECRET=
# Guild for instant command registration during development (empty = global)
DISCORD_DEV_GUILD_ID=

# Sync slash commands with Discord on bot startup (only differences are changed)
AUTO_DEPLOY_COMMANDS=true

# --- Sharding ---
# auto — as recommended by Discord
TOTAL_SHARDS=auto
SHARDS_PER_CLUSTER=4

# --- Storage ---
POSTGRES_USER=bot
POSTGRES_PASSWORD=bot
POSTGRES_DB=bot
DATABASE_URL=postgresql://bot:bot@localhost:5432/bot
REDIS_URL=redis://localhost:6379

# --- API ---
API_HOST=127.0.0.1
API_PORT=3000
# Host port the API container is published on (127.0.0.1 only); change it when 3000 is taken on the server
API_PUBLISHED_PORT=3000
# Public API URL; add <API_PUBLIC_URL>/v1/auth/callback to OAuth2 → Redirects
API_PUBLIC_URL=http://localhost:3000
# Web platform URL (CORS and post-login redirect); empty — login lands on the API Swagger UI
WEB_ORIGIN=
# Servers may change the bot's name, avatar, banner and "About me" on them from the dashboard: true | false
BOT_PROFILE_EDITS=true
# Requests per minute per user or IP; 0 — unlimited (load tests only)
API_RATE_LIMIT_PER_MINUTE=120
# Cookie signing and token encryption, at least 32 characters: openssl rand -base64 32
SESSION_SECRET=
# External dashboards with their own sign-in (e.g. RemnaWeb): id:secret:callbackUrl, comma-separated.
# The secret is at least 32 characters; the callback receives ?code=…&state=… after Discord login.
# Example: remnaweb:<openssl rand -base64 32>:https://web.example.com/api/discord/link/callback
LINK_CLIENTS=

# --- Leveling ---
# Renderer of the /rank picture card, e.g. https://web.example.com/api/discord/cards/rank (RemnaWeb, which also dresses
# it in the cosmetics of whoever linked that Discord there); empty — /rank answers with an embed
RANK_CARD_URL=
# Bearer token for RANK_CARD_URL; for RemnaWeb — its secret in LINK_CLIENTS (DISCORD_LINK_SECRET there)
RANK_CARD_SECRET=

# --- Notifications ---
# Twitch app (dev.twitch.tv/console) for stream notifications; empty — Twitch is unavailable
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Music ---
# Lavalink audio nodes, comma-separated: lavalink://<password>@<host>:<port>, lavalinks:// for TLS.
# With the compose node (COMPOSE_PROFILES=app,music): lavalink://<LAVALINK_PASSWORD>@lavalink:2333; empty — music is off
LAVALINK_NODES=
# Password and heap of the compose Lavalink node
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_MEMORY=512M
# Search sources of the Lavalink plugins (docker/lavalink/application.yml). Bandcamp needs nothing.
# YouTube and YouTube Music (youtube-plugin); false — off
YOUTUBE_ENABLED=true
# Sign-in to YouTube when it asks the server to log in: true, then the code from the Lavalink log at google.com/device
# (a spare Google account); the log then prints the refresh token to keep here
YOUTUBE_OAUTH=false
YOUTUBE_REFRESH_TOKEN=
# Decipher server of YouTube stream signatures; empty — the compose yt-cipher (http://yt-cipher:8001)
YOUTUBE_CIPHER_URL=
# Spotify (LavaSrc): an app at developer.spotify.com; its tracks play from YouTube Music
SPOTIFY_ENABLED=false
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_COUNTRY=US
# Deezer (LavaSrc): the arl cookie of a Deezer account and the master decryption key
DEEZER_ENABLED=false
DEEZER_ARL=
DEEZER_MASTER_KEY=
# Yandex Music (LavaSrc): an account's access token; Yandex blocks some regions
YANDEX_MUSIC_ENABLED=false
YANDEX_MUSIC_TOKEN=

# --- Worker ---
WORKER_POLL_MS=2000
WORKER_HEALTH_PORT=3002
# Data of a server the bot was removed from is deleted after this many days
GUILD_DATA_RETENTION_DAYS=30
# Finished scheduled jobs are kept this many days
JOB_HISTORY_DAYS=7

# --- Deploy (server .env; see deploy.sh) ---
# Registry path of the images built by CI, e.g. ghcr.io/<owner>/<repo>; empty — local builds
IMAGE_REPO=
# Pinned by deploy.sh to the deployed build
IMAGE_TAG=latest
# Enables the app containers for a plain `docker compose up -d`
# COMPOSE_PROFILES=app
# Extra compose files, separated by ":", e.g. docker-compose.yml:docker/monitoring/shared-network.yml
# COMPOSE_FILE=docker-compose.yml

# --- Backups (backup.sh) ---
# Snapshots kept in backups/
BACKUP_KEEP=14
# rclone remote for off-server copies, e.g. b2:discord-bot-backups; empty — local only
BACKUP_REMOTE=
BACKUP_REMOTE_KEEP=30

# --- Metrics (external Prometheus, see docker/monitoring/) ---
# Internal port of the API /metrics; the bot and the worker serve /metrics on their health ports
API_METRICS_PORT=9464
# Bearer token for /metrics, at least 16 characters; required with docker/monitoring/published-ports.yml
METRICS_TOKEN=
# Docker network of the monitoring stack for docker/monitoring/shared-network.yml
MONITORING_NETWORK=monitoring-network

# --- Misc ---
LOG_LEVEL=info
DEFAULT_LOCALE=ru
BOT_HEALTH_PORT=3001
