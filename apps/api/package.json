{
  "name": "@bot/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development --env-file-if-exists=../../.env src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "openapi:export": "tsx --conditions=development scripts/export-openapi.ts"
  },
  "dependencies": {
    "@bot/contracts": "workspace:*",
    "@bot/core": "workspace:*",
    "@bot/db": "workspace:*",
    "@bot/discord": "workspace:*",
    "@bot/i18n": "workspace:*",
    "@bot/logger": "workspace:*",
    "@bot/module-list": "workspace:*",
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.4.1",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/swagger": "9.9.3",
    "@fastify/swagger-ui": "6.1.3",
    "discord-api-types": "0.38.58",
    "discord.js": "14.28.1",
    "fastify": "5.12.8",
    "fastify-plugin": "6.0.1",
    "fastify-type-provider-zod": "7.0.0",
    "ioredis": "6.0.0",
    "prom-client": "15.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@bot/config": "workspace:*",
    "@bot/module-moderation": "workspace:*",
    "@bot/testing": "workspace:*"
  }
}
